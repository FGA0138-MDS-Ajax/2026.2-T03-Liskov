# Configuração do painel Streamlit. Copie para .env (arquivo ignorado pelo Git).
# Este arquivo não deve conter segredos.

# mock: dados de exemplo fictícios | api: API FastAPI real
SENTIA_FONTE_DADOS=mock

# Só para o modo mock. normal | vazio | erro (para validar os estados da tela)
SENTIA_MOCK_CENARIO=normal

# Só para o modo api.
SENTIA_API_URL=http://localhost:8000
SENTIA_API_TIMEOUT_SEGUNDOS=5
