MONGODB_URI=mongodb://localhost:27017/seu_banco_de_dados
# ou para MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<usuario>:<senha>@cluster.mongodb.net/?retryWrites=true&w=majority
# Administração da API (issue #58). Sem estas duas variáveis, o login responde 503.
# Gere o hash com `make hash-senha`. Nunca coloque a senha em texto puro nem faça commit do .env.
SENTIA_ADMIN_USUARIO=admin
SENTIA_ADMIN_SENHA_HASH=
# Opcionais: duração da sessão, tamanho máximo do CSV e textos lidos do TweetSentBR por coleta.
SENTIA_SESSAO_MINUTOS=60
SENTIA_LIMITE_CSV_MB=10
SENTIA_LIMITE_COLETA=1000
