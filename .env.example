# Copie para .env; não coloque credenciais neste arquivo versionado.
SENTIA_FONTE_DADOS=mock
SENTIA_MOCK_CENARIO=normal
SENTIA_API_URL=http://localhost:8000
SENTIA_API_TIMEOUT_SEGUNDOS=5

# Administração na API (#58). Sem estas duas, as rotas de administração respondem 503.
# Gere o hash com: uv run python -m src.servico.autenticacao
SENTIA_ADMIN_USUARIO=
SENTIA_ADMIN_SENHA_HASH=
# Opcionais: duração da sessão em minutos, tamanho máximo do CSV em MB e textos do
# TweetSentBR por coleta.
SENTIA_SESSAO_MINUTOS=60
SENTIA_LIMITE_CSV_MB=10
SENTIA_LIMITE_COLETA=1000

# Apenas para conexão explícita ao banco. A demonstração mock não usa MongoDB.
MONGODB_URI=mongodb://localhost:27017/sentia

# Opcional: chave para coleta real via módulo XFetch; não é necessário na demonstração offline.
XFETCH_API_KEY=
